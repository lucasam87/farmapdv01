# ============================================================
# Copie este arquivo para .env.local e preencha os valores.
# O .env.local NUNCA vai para o git (ver .gitignore).
# ============================================================

# Supabase -> Project Settings -> Data API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase -> Project Settings -> API Keys -> chave PUBLICA.
# Pode aparecer como "anon" ou "publishable". A chave secreta
# (service_role / secret) NAO vai aqui e nao vai para o navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave da API do DeepSeek (usada na Etapa 8, somente no servidor).
# https://platform.deepseek.com/api_keys
# NUNCA prefixar com NEXT_PUBLIC_ — isso a exporia ao navegador.
DEEPSEEK_API_KEY=

# Supabase -> Connect -> "Session pooler" (porta 5432).
# Usada SOMENTE pelas ferramentas locais (migrations e testes SQL).
# O aplicativo em si nao usa esta variavel.
SUPABASE_DB_URL=
