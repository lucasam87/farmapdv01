# ============================================================
# Copie este arquivo para .env.local e preencha os valores.
# O .env.local NUNCA vai para o git (ver .gitignore).
# ============================================================

# Supabase -> Project Settings -> Data API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase -> Project Settings -> API Keys -> chave PUBLICA.
# Pode aparecer como "anon" ou "publishable". A chave secreta
# (service_role / secret) NÃO tem prefixo NEXT_PUBLIC_ e NÃO vai para o
# navegador — ela é a variável SUPABASE_SERVICE_ROLE_KEY logo abaixo.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave da API do DeepSeek (usada na Etapa 8, somente no servidor).
# https://platform.deepseek.com/api_keys
# NUNCA prefixar com NEXT_PUBLIC_ — isso a exporia ao navegador.
DEEPSEEK_API_KEY=

# Supabase -> Project Settings -> API Keys -> chave SECRETA (service_role).
# SOMENTE NO SERVIDOR: sem prefixo NEXT_PUBLIC_, nunca no bundle do cliente.
# Sem ela o agente responde 502 SEMPRE: a rota reserva orçamento antes de falar
# com o DeepSeek, e a reserva é uma RPC que só a service_role executa — nenhuma
# das quatro consultas passa do orçamento. É usada SÓ para o ledger de orçamento
# (reservar/reconciliar/liberar), nunca para ler as views de negócio.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase -> Connect -> "Session pooler" (porta 5432).
# Usada SOMENTE pelas ferramentas locais (migrations e testes SQL).
# O aplicativo em si nao usa esta variavel.
SUPABASE_DB_URL=
